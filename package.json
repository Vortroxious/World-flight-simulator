{
  "name": "world-flight-simulator",
  "version": "0.2.0",
  "description": "WORLD FLIGHT SIMULATOR - browser flight simulator (Three.js / WebGL2)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "data:airports": "node scripts/build-airports.mjs",
    "data:osm": "node scripts/bake-osm-airport.mjs",
    "data:terrain": "node scripts/bake-terrain-fallback.mjs",
    "data:all": "npm run data:airports && npm run data:osm && npm run data:terrain"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
